<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- Only the game-independent logic is tested; it's compiled in directly. BepInEx.Core is plain .NET, so the real
       one (copied out of the game by scripts/update-refs.sh) is used rather than the reference-only lib/refs copy. -->
  <ItemGroup>
    <Compile Include="../../src/InvokyrConfig/SettingsRegistry.cs" Link="SettingsRegistry.cs" />
    <Compile Include="../../src/InvokyrConfig/SettingAttributes.cs" Link="SettingAttributes.cs" />
    <Compile Include="../../src/InvokyrConfig/SettingValues.cs" Link="SettingValues.cs" />
    <Compile Include="../../src/InvokyrConfig/ConfigWriter.cs" Link="ConfigWriter.cs" />
    <Compile Include="../../src/InvokyrConfig/OverlayState.cs" Link="OverlayState.cs" />
    <Compile Include="../../src/InvokyrConfig/RestoreGate.cs" Link="RestoreGate.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core" HintPath="$(HOME)/.cache/invokyr/core/BepInEx.Core.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
